TG_BOT_TOKEN=
TG_USER_ID=
# OpenCode Go (OpenAI-compatible)
LLM_PROVIDER=openai_compatible
LLM_MODEL="deepseek-v4.1-flash"
LLM_TIMEOUT_SECONDS=120
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0
LLM_MAX_OUTPUT_TOKENS=4000
LLM_MAX_REQUESTS_PER_DAY=2000

OPENAI_COMPATIBLE_BASE_URL="https://opencode.ai/inference/go/openai/v1"
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_JSON_MODE=true
OPENAI_COMPATIBLE_REASONING_ENABLED=
OPENAI_COMPATIBLE_REASONING_EFFORT=low
# Vision-модель для капчи; пусто = LLM_MODEL.
CAPTCHA_MODEL="deepseek-v4.1-flash"
# Переключать капчу HH на английскую версию: латиницу модель читает лучше.
CAPTCHA_SWITCH_TO_ENGLISH=true

# dry_run | approval | auto
# auto = non-AI vacancies are applied to automatically; AI/LLM vacancies go to Telegram.
APP_MODE=dry_run
ENABLE_REAL_APPLY=false
LEGEND_PATH=legend/legend_full.json

BROWSER_BACKEND=cloakbrowser
BROWSER_HEADLESS=false
BROWSER_PROFILE_DIR=.browser-profile

CHECK_INTERVAL_MINUTES=30
MAX_APPLICATIONS_PER_DAY=5
MAX_VACANCIES_PER_QUERY=20
MAX_PAGES_PER_QUERY=2
# Сортировка выдачи: publication_time — свежие сверху, relevance — по соответствию.
HH_ORDER_BY=publication_time
# Период поиска: 0 — всё время, 1 — сутки, 3 — три дня, 7 — неделя.
HH_SEARCH_PERIOD=1
MIN_SECONDS_BETWEEN_ACTIONS=5
APPROVAL_TTL_MINUTES=30
AUTO_APPLY_ENABLED=false
AUTO_APPLY_MIN_CONFIDENCE=0.85
AUTO_APPLY_MIN_BATCH_SIZE=5
AUTO_APPLY_MAX_BATCH_SIZE=6
AUTO_APPLY_MIN_INTERVAL_HOURS=3
AUTO_APPLY_MAX_INTERVAL_HOURS=5
AUTO_APPLY_START_HOUR=10
AUTO_APPLY_END_HOUR=22
AUTO_APPLY_TIMEZONE=UTC
CAPTCHA_TIMEOUT_SECONDS=120
CAPTCHA_MAX_ATTEMPTS=2
CIRCUIT_BREAKER_MIN_SAMPLE=5
CIRCUIT_BREAKER_UNKNOWN_RATIO=0.8
CIRCUIT_BREAKER_PAGE_ERRORS=3

# Страница очереди: список ожидающих вакансий в браузере.
# QUEUE_PAGE_PUBLIC_URL должен быть доступен с телефона/ноутбука (LAN или внешний адрес).
QUEUE_PAGE_ENABLED=false
QUEUE_PAGE_HOST=0.0.0.0
QUEUE_PAGE_PORT=8787
QUEUE_PAGE_PUBLIC_URL=
QUEUE_PAGE_SECRET=
